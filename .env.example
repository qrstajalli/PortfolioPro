# ==============================================================================
# PortfolioPro Environment Configuration Template
# Copy this file to '.env' and customize for your local or production environment.
# NOTE: Never commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# Active Spring Profile: 'default' for persistent MySQL, or 'local-h2' for in-memory testing
SPRING_PROFILES_ACTIVE=default

# Server Port
PORT=8080

# MySQL Database Connection Details
DB_URL=jdbc:mysql://localhost:3306/portfoliopro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Hibernate DDL Setting (update recommended for persistent schema migrations)
JPA_DDL_AUTO=update
SHOW_SQL=false

# JWT Authentication Security
JWT_SECRET=4a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=portfoliopro

# Portfolio Settings
DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Service Configuration (SMTP Provider e.g. SendGrid, Mailgun, AWS SES, Gmail)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@portfoliopro.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Development Mode (allows token verification in local environments without SMTP)
AUTH_DEV_MODE=true
FRONTEND_URL=http://localhost:5173

# Alpha Vantage Market Data API Configuration
ALPHA_VANTAGE_API_KEY=your_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co

# Google OAuth 2.0 / OIDC Configuration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

